    dialogueLines:
    - character:
        name: Tutorial
      dialogue: This fishing rod can make items appear as if they are levitating.
    - character:
        name: Tutorial
      dialogue: Try it on the book on the stool. Click the mouse to cast the fishing
        rod and use the scrollwheel to lift the object.

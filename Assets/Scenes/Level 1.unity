  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    dialogueLines:
    - character:
        name: Tutorial
      dialogue: 'This knife can seemingly make light fixtures ''fall on their own''.. '
    - character:
        name: Tutorial
      dialogue: 'Head to the basement and test it out on the light bulb by clicking
        on it with the knife equipped. '
--- !u!114 &598847761

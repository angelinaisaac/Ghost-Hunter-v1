  m_Script: {fileID: 11500000, guid: ac472c2d15f8a704fa6d2898b19fc7b4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    dialogueLines:
    - character:
        name: Mia
      dialogue: 'My name is Mia. I''m supposed to be a ghost hunter. '
    - character:
        name: Mia
      dialogue: I quit my job to pursue ghost hunting and I ended up landing a meeting
        with a high profile producer to pitch a ghost hunting show!
    - character:
        name: Mia
      dialogue: 'She asked me to bring undeniable proof, but after months of trying
        I caught nothing. '
    - character:
        name: Mia
      dialogue: 'Im on my way to the meeting now, empty handed. I need this job more
        than ever. '
    - character:
        name: Mia
      dialogue: .   .   .wait i have an idea. why dont I just fake it? Easy!
    - character:
        name: Mia
      dialogue: ...

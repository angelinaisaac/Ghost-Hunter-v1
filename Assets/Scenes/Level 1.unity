  m_Script: {fileID: 11500000, guid: ac472c2d15f8a704fa6d2898b19fc7b4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    dialogueLines:
    - character:
        name: Tutorial
      dialogue: Great you've completed all your tasks!
    - character:
        name: Tutorial
      dialogue: 'You are off to an abandoned movie set. '
    - character:
        name: Tutorial
      dialogue: The secuirty guards are between shifts now, so go! You only have
        a limited time before they get back.
    - character:
        name: Tutorial
      dialogue: 'You need at least 50 evidence points, but you don''t <i>have</i>
        to collect all evidence.. but you still can.. Do what you think will convince
        the producer! '
